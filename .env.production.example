# Environment Configuration for EC2 Production
# Copy this file to .env and customize with your actual values

# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_NAME=comandas

# Frontend Configuration (S3 + CloudFront)
FRONTEND_URL=https://your-domain.s3.amazonaws.com
CLOUDFRONT_DOMAIN=https://your-domain.cloudfront.net

# Application Configuration
NODE_ENV=production
LOG_LEVEL=info

# EC2 Security
# Make sure to configure security groups to allow:
# - Port 5000 (API) from CloudFront and your IP
# - Port 5432 (PostgreSQL) only from backend container
# - Port 22 (SSH) from your IP only
